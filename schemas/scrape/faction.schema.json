{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thestackshepherd/sbapi/schemas/scrape/faction.schema.json",
  "title": "Faction",
  "description": "An organisation or group. Use null (or an empty array) for anything the page doesn't state; never guess.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "faction_name",
    "source_url"
  ],
  "properties": {
    "faction_name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Summary."
    },
    "leader": {
      "type": [
        "string",
        "null"
      ],
      "description": "Leader's character name."
    },
    "parody_of": {
      "$ref": "common.schema.json#/$defs/parody_of"
    },
    "image_url": {
      "$ref": "common.schema.json#/$defs/image_url"
    },
    "source_url": {
      "$ref": "common.schema.json#/$defs/source_url"
    },
    "trivia": {
      "$ref": "common.schema.json#/$defs/trivia"
    },
    "citations": {
      "$ref": "common.schema.json#/$defs/citations"
    }
  }
}
